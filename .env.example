# Copy to .env and fill in only the providers you want to use.
# A provider without a key is skipped automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama GPU tuning. These are read by the Ollama server, so set them as
# system environment variables and restart Ollama (setup.ps1 does this):
#   OLLAMA_FLASH_ATTENTION=1        faster attention, less VRAM
#   OLLAMA_KV_CACHE_TYPE=q8_0       halves context-cache VRAM
#   OLLAMA_MAX_LOADED_MODELS=1      on <16 GB cards, don't keep text + vision models loaded together
